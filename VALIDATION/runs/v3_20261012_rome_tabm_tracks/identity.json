{
  "design": {
    "parent": "exact v78 and separately coefficient-one transport onto v79",
    "change": "one-third TabM Rome copy probability, with matched tabular and learned-physical arms",
    "primary": "physical versus exact selected parent; tabular diagnoses family versus track benefit",
    "model": {
      "tabular_columns": 75,
      "encoding": "unchanged history-free Rome classifier encoder and32-bin PLE8",
      "k": 32,
      "n_blocks": 2,
      "d_block": 512,
      "dropout": 0.1,
      "activation": "ReLU",
      "arch_type": "tabm",
      "start_scaling_init": "normal",
      "batch": 2048,
      "micro": 512,
      "inference_batch": 512,
      "max_epochs": 48,
      "lr": 0.002,
      "weight_decay": 0.0003,
      "gradient_clip": 1.0,
      "seed": 42,
      "loss": "unweighted BCEWithLogits over rows and all32 individual heads",
      "inference": "mean of32 sigmoid probabilities, not sigmoid of mean logit",
      "stopping": "minimum inner-month mean-probability log loss; first epoch on a tie",
      "schedule": "OneCycle over48 epochs in inner and full fits; refit full at chosen epoch",
      "physical": "retained physical CNN plus trainable zero-initialized64-to64 projection",
      "missing": "projected raw-track representation zero for fewer than2points; same9quality inputs in both arms",
      "arms": [
        "tabular",
        "physical"
      ],
      "no_search": true
    },
    "rows": "original R20 Rome membership and binary abs(gap-y)<=60 target",
    "inputs": "75 history-free original columns and identical9 track-quality inputs",
    "inner": "last allowed training month; encoder/bins fit on remaining training months only",
    "stopping": "minimum inner-month probability logloss; first epoch on a tie; full refit at selected epoch",
    "probability": "(2/3)*(.5*publicCat3+.5*originalR20)+(1/3)*new; unchanged outside Rome",
    "arms": [
      "tabular",
      "physical"
    ],
    "seed": 42,
    "machine": "desktop RTX3080",
    "fixed_tracks": "original full2025 sparse physical cache; no source rebuild",
    "evaluation": "reused Jan/Jul development; one fixed seed, no independent confirmation",
    "no_blend_search": true,
    "no_architecture_search": true,
    "no_label_weighting": true,
    "no_upload": true
  },
