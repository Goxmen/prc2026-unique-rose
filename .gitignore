VALIDATION/**/runs/v3_*/continuations/*/source/
VALIDATION/**/runs/v3_*/continuations/*/source.patch

# Seasonal validation keeps models, predictions and implementation copies local.
VALIDATION/runs/seasonal_*/source/
VALIDATION/runs/seasonal_*/models/
VALIDATION/runs/seasonal_*/progress.json
VALIDATION/runs/seasonal_*/.lock
VALIDATION/runs/seasonal_*/*.parquet.tmp
